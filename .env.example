# Meta WhatsApp Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_ACCESS_TOKEN=replace_with_permanent_access_token
WHATSAPP_API_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=replace_with_random_webhook_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_REQUIRE_SIGNATURE=false

# Admin dashboard authentication: replace every value before deployment.
ADMIN_USERNAME=change_this_admin_username
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_a_random_secret_from_secrets_token_urlsafe

# Supabase: use a server-side secret/service-role key; never put it in the UI.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Model configuration. Gemini integration is intentionally not enabled.
# For hosted deployment set LLM_PROVIDER=openai and OPENAI_API_KEY.
# For local Ollama set LLM_PROVIDER=ollama and OLLAMA_ENABLED=true.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=8

# Cookies must be secure on HTTPS deployments. Use false only for local HTTP.
COOKIE_SECURE=false
